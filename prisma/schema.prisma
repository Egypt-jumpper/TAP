generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum AdSide { BUY SELL }
enum OrderStatus { CREATED FUNDED ACCEPTED PAYMENT_PENDING PAYMENT_SENT SELLER_CONFIRMING COMPLETED CANCELLED EXPIRED DISPUTED REFUNDED }

model User {
 id String @id @default(cuid())
 walletAddress String @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ads Ad[]
 buyerOrders Order[] @relation("buyer")
 sellerOrders Order[] @relation("seller")
 authNonces AuthNonce[]
}

model AuthNonce {
 id String @id @default(cuid())
 walletAddress String
 nonce String @unique
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 @@index([walletAddress, expiresAt])
}

model Ad {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 side AdSide
 asset String
 price String
 availableAmount String
 minAmount String
 maxAmount String
 paymentAsset String @default("USDT")
 paymentNetwork String
 paymentTokenContract String
 paymentMethods String
 terms String?
 active Boolean @default(true)
 paymentWindowMinutes Int @default(30)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 orders Order[]
 @@index([active, side, createdAt])
 @@index([paymentNetwork, paymentTokenContract, active])
}

model Order {
 id String @id @default(cuid())
 adId String
 ad Ad @relation(fields:[adId],references:[id])
 buyerId String
 buyer User @relation("buyer",fields:[buyerId],references:[id])
 sellerId String
 seller User @relation("seller",fields:[sellerId],references:[id])
 amount String
 price String
 paymentAmount String
 paymentAsset String @default("USDT")
 paymentNetwork String
 paymentTokenContract String
 paymentSender String?
 paymentReceiver String
 paymentConfirmations Int @default(0)
 paymentVerificationReason String?
 paymentVerifiedAt DateTime?
 status OrderStatus @default(CREATED)
 escrowContract String?
 escrowTxHash String?
 escrowOrderId String?
 paymentTxHash String?
 expiresAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status, createdAt])
 @@index([paymentNetwork, paymentTxHash])
}